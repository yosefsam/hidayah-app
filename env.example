# --- Public site URL (required in production: https://hidayah.io) ---
# Used for:
# - Server redirects from /auth/callback (getSiteUrl)
# - Supabase email links: signup confirmation & password reset (getAuthSiteUrl on the client)
# Custom SMTP is configured in Supabase Dashboard → Project Settings → Auth → SMTP (not here).
NEXT_PUBLIC_SITE_URL=https://hidayah.io

# --- Supabase (required for auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional alternative to anon key (Supabase publishable key format):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only: service role for trusted admin writes (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
